import {
  "Zh666-lab/moonrfb" @rfb,
}

supported_targets = "js"

options(
  link: {
    "js": {
      "exports": [
        "create",
        "feed",
        "finish",
        "ready",
        "outgoing",
        "events",
        "pixels",
        "width",
        "height",
        "key",
        "pointer",
        "cut_text",
        "refresh",
        "raw",
        "trle",
        "auth",
      ],
      "format": "cjs",
    },
  },
)
